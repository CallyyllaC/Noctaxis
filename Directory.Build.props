<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14.0</LangVersion>
    <Deterministic>true</Deterministic>
    <!-- The language of the text in the .resx files: British English, the only language shipped in v1.
         A translation is a satellite file beside each, e.g. Settings.fr.resx (see docs/localisation.md). -->
    <NeutralLanguage>en-GB</NeutralLanguage>
  </PropertyGroup>

  <!--
    Noctaxis version X.Y.Z for every project in the repository.
      X.Y  NoctaxisVersion (below) is the only repository-controlled source of truth.
           X is changed by hand only. Y is incremented automatically, once, when dev is merged
           into main (.github/workflows/version-bump.yml via scripts/noctaxis_version.py), which
           rewrites the NoctaxisVersion element text and nothing else in this file.
      Z    NoctaxisBuildNumber, supplied by CI (the NoctaxisBuildNumber environment variable or
           -p:NoctaxisBuildNumber=N). Local builds fall back to 0.
    Directory.Build.targets rejects malformed values.
  -->
  <PropertyGroup>
    <NoctaxisVersion>0.2</NoctaxisVersion>
    <NoctaxisBuildNumber Condition="'$(NoctaxisBuildNumber)' == ''">0</NoctaxisBuildNumber>
    <VersionPrefix>$(NoctaxisVersion).$(NoctaxisBuildNumber)</VersionPrefix>
  </PropertyGroup>
</Project>
