<views:NoctaxisDialogWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Noctaxis.Desktop.Localisation"
        xmlns:views="clr-namespace:Noctaxis.Desktop.Views"
        x:Class="Noctaxis.Desktop.Views.ConfirmationDialog"
        x:CompileBindings="False"
        Width="460" Height="230" MinWidth="380" MinHeight="210">
  <Border Classes="noctaxisDialogSurface">
  <Grid RowDefinitions="*,Auto" Margin="22" RowSpacing="18">
    <ScrollViewer><StackPanel Spacing="10">
      <TextBlock TextWrapping="Wrap" x:Name="HeadingText" FontSize="{DynamicResource TextHeading}" FontWeight="SemiBold"/>
      <TextBlock x:Name="MessageText" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap"/>
    </StackPanel></ScrollViewer>
    <!-- The actions wrap onto a second line when their labels are long (another language, large text). -->
    <WrapPanel Grid.Row="1" HorizontalAlignment="Right" ItemSpacing="8" LineSpacing="8">
      <!-- Cancel takes focus when the dialog opens and Enter never confirms by default: a stray key press must not
           remove anything. The destructive button names its action and uses the error colours. -->
      <Button x:Name="CancelButton" Content="{loc:Text Common_Cancel_Button}" Click="CancelClick" IsCancel="True" MinWidth="88"/>
      <Button x:Name="ConfirmButton" Classes="destructive" Click="ConfirmClick" MinWidth="88"/>
    </WrapPanel>
  </Grid>
  </Border>
</views:NoctaxisDialogWindow>
