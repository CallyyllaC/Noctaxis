<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Noctaxis.Desktop.Controls"
        xmlns:views="clr-namespace:Noctaxis.Desktop.Views"
        xmlns:diagnostics="clr-namespace:Noctaxis.Desktop.Diagnostics"
        x:Class="Noctaxis.Desktop.Views.MainWindow"
        x:CompileBindings="False"
        Title="Noctaxis — Astral photography planner"
        Width="1440" Height="900" MinWidth="720" MinHeight="560"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="44">
  <Window.Resources><controls:RadioChoiceConverter x:Key="RadioChoice"/></Window.Resources>
  <Window.Styles>
    <Style Selector="RadioButton.settingsChoice">
      <Style.Resources>
        <SolidColorBrush x:Key="RadioButtonOuterEllipseFill" Color="{DynamicResource InputBackgroundColor}"/>
        <SolidColorBrush x:Key="RadioButtonOuterEllipseStroke" Color="{DynamicResource SurfaceBorderColor}"/>
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="{DynamicResource SelectionBackgroundColor}"/>
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="{DynamicResource SelectionBackgroundColor}"/>
        <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="{DynamicResource SelectionForegroundColor}"/>
        <SolidColorBrush x:Key="RadioButtonCheckGlyphStroke" Color="{DynamicResource SelectionForegroundColor}"/>
        <SolidColorBrush x:Key="RadioButtonForeground" Color="{DynamicResource PrimaryTextColor}"/>
        <SolidColorBrush x:Key="RadioButtonOuterEllipseFillPointerOver" Color="{DynamicResource ButtonHoverColor}"/>
        <SolidColorBrush x:Key="RadioButtonOuterEllipseStrokePointerOver" Color="{DynamicResource SurfaceBorderColor}"/>
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" Color="{DynamicResource SelectionBackgroundColor}"/>
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="{DynamicResource SelectionBackgroundColor}"/>
        <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPointerOver" Color="{DynamicResource SelectionForegroundColor}"/>
        <SolidColorBrush x:Key="RadioButtonCheckGlyphStrokePointerOver" Color="{DynamicResource SelectionForegroundColor}"/>
        <SolidColorBrush x:Key="RadioButtonForegroundPointerOver" Color="{DynamicResource PrimaryTextColor}"/>
        <SolidColorBrush x:Key="RadioButtonOuterEllipseFillPressed" Color="{DynamicResource ButtonPressedColor}"/>
        <SolidColorBrush x:Key="RadioButtonOuterEllipseStrokePressed" Color="{DynamicResource SurfaceBorderColor}"/>
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPressed" Color="{DynamicResource SelectionBackgroundColor}"/>
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePressed" Color="{DynamicResource SelectionBackgroundColor}"/>
        <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPressed" Color="{DynamicResource SelectionForegroundColor}"/>
        <SolidColorBrush x:Key="RadioButtonCheckGlyphStrokePressed" Color="{DynamicResource SelectionForegroundColor}"/>
        <SolidColorBrush x:Key="RadioButtonForegroundPressed" Color="{DynamicResource PrimaryTextColor}"/>
        <SolidColorBrush x:Key="RadioButtonOuterEllipseFillDisabled" Color="{DynamicResource ButtonDisabledColor}"/>
        <SolidColorBrush x:Key="RadioButtonOuterEllipseStrokeDisabled" Color="{DynamicResource SurfaceBorderColor}"/>
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillDisabled" Color="{DynamicResource SelectionBackgroundColor}"/>
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokeDisabled" Color="{DynamicResource SelectionBackgroundColor}"/>
        <SolidColorBrush x:Key="RadioButtonCheckGlyphFillDisabled" Color="{DynamicResource SelectionForegroundColor}"/>
        <SolidColorBrush x:Key="RadioButtonCheckGlyphStrokeDisabled" Color="{DynamicResource SelectionForegroundColor}"/>
        <SolidColorBrush x:Key="RadioButtonForegroundDisabled" Color="{DynamicResource DisabledTextColor}"/>
      </Style.Resources>
      <Setter Property="Margin" Value="0,0,20,8"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style Selector="RadioButton.settingsChoice:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource FocusBorder}"/>
      <Setter Property="BorderThickness" Value="{DynamicResource StateFocusThickness}"/>
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="44,Auto,*">
    <Border Grid.Row="0"
            Background="{DynamicResource SurfaceBackground}"
            BorderBrush="{DynamicResource SurfaceBorder}"
            BorderThickness="0,0,0,1"
            WindowDecorationProperties.ElementRole="TitleBar">
      <Grid ColumnDefinitions="*,46,46,46">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,10,0" Spacing="10">
          <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource Accent}" />
          <TextBlock TextWrapping="Wrap" Text="NOCTAXIS" FontSize="{DynamicResource TextLabel}" FontWeight="SemiBold" LetterSpacing="1.6" VerticalAlignment="Center" />
          <Border Width="1" Height="16" Background="{DynamicResource ButtonBackground}" Margin="2,0" />
          <TextBlock TextWrapping="Wrap" Text="Astral photography planner" FontSize="{DynamicResource TextSmall}" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" />
        </StackPanel>
        <Button Grid.Column="1"
                Classes="titleBarButton"
                Content="−"
                Click="MinimizeWindowClick"
                WindowDecorationProperties.ElementRole="MinimizeButton"
                ToolTip.Tip="Minimize"
                AutomationProperties.Name="Minimize window" />
        <Button x:Name="MaximizeWindowButton"
                Grid.Column="2"
                Classes="titleBarButton"
                Content="□"
                Click="MaximizeRestoreWindowClick"
                WindowDecorationProperties.ElementRole="MaximizeButton"
                ToolTip.Tip="Maximize"
                AutomationProperties.Name="Maximize or restore window" />
        <Button x:Name="CloseWindowButton"
                Grid.Column="3"
                Classes="titleBarButton titleBarClose"
                Content="×"
                Click="CloseWindowClick"
                WindowDecorationProperties.ElementRole="User"
                ToolTip.Tip="Close"
                AutomationProperties.Name="Close window" />
      </Grid>
    </Border>

    <TabControl Grid.Row="2" Padding="0" SelectedIndex="{Binding SelectedPageIndex}" TabStripPlacement="Top">
    <TabItem Header="Locations">
      <views:LocationsPage/>
    </TabItem>

    <TabItem Header="Planner">
      <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="0,0,0,1" Padding="12">
          <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
            <StackPanel Margin="0,0,12,6"><TextBlock TextWrapping="Wrap" Text="Date" Classes="fieldLabel"/><DatePicker SelectedDate="{Binding LocalDate}" MinWidth="{DynamicResource DatePickerMinimumWidth}" /></StackPanel>
            <StackPanel Margin="0,0,12,6"><TextBlock TextWrapping="Wrap" Text="Local time" Classes="fieldLabel"/><TextBox Text="{Binding TimeText}" MinWidth="100" HorizontalContentAlignment="Center" /></StackPanel>
            <Button Content="Previous day" Command="{Binding PreviousDayCommand}" Margin="0,18,6,6" />
            <Button Content="Next day" Command="{Binding NextDayCommand}" Margin="0,18,6,6" />
            <Button Content="Now" Command="{Binding NowCommand}" Margin="0,18,12,6" />
            <TextBlock TextWrapping="Wrap" Text="{Binding TimeZoneId}" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="0,12,16,0" />
            <Button Content="Save PNG" Click="ExportPngClick" Margin="0,18,6,6" IsEnabled="{Binding CanExport}" />
            <Button Content="Copy PNG" Click="CopyPngClick" Margin="0,18,6,6" IsEnabled="{Binding CanExport}" />
          </WrapPanel>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
          <Grid>
            <controls:PlannerMapView x:Name="PlannerMap"
                                      Observer="{Binding Observer}"
                                      Snapshot="{Binding Snapshot}"
                                      FramingGuide="{Binding CameraFramingGuide}"
                                      FramingVisibility="{Binding CameraFramingVisibility}"
                                      FramingSettings="{Binding CameraFramingMapSettings}"
                                       PinActivity="{Binding PlannerPinActivity}"
                                       ShowCelestialOverlays="{Binding CelestialOverlaysReady}"
                                       ShowCameraOverlay="{Binding CameraOverlayReady}"
                                       LightPollutionPreferences="{Binding LightPollutionMapPreferences}"
                                       ShowTerrainDebug="False" />
            <Border x:Name="PlannerRefreshStrip"
                    Background="{DynamicResource SurfaceBackground}"
                    BorderBrush="{DynamicResource SurfaceBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,7"
                    Margin="244,52,12,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    IsHitTestVisible="False"
                    IsVisible="{Binding IsPlannerRefreshing}">
              <Grid RowDefinitions="Auto,3" RowSpacing="5">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                  <TextBlock TextWrapping="Wrap" Text="PLANNER" FontSize="{DynamicResource TextCaption}" FontWeight="SemiBold" LetterSpacing="1.1" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                  <TextBlock TextWrapping="Wrap" Grid.Column="1" Text="{Binding PlannerRefreshStatusText}" FontSize="{DynamicResource TextSmall}" Foreground="{DynamicResource PrimaryText}" TextTrimming="CharacterEllipsis" />
                </Grid>
                <ProgressBar x:Name="PlannerRefreshProgressBar" Grid.Row="1" Minimum="0" Maximum="1" Value="{Binding PlannerRefreshProgress}" Height="3" />
              </Grid>
            </Border>
            <Border Background="{DynamicResource SurfaceBackground}" CornerRadius="7" Padding="10,6" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="244,0,12,12">
              <StackPanel>
                <TextBlock TextWrapping="Wrap" Text="Planning pin preview" Foreground="{DynamicResource SecondaryText}" FontSize="{DynamicResource TextSmall}" />
                <TextBlock TextWrapping="Wrap" Text="{Binding PreviewObserver}" />
              </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Spacing="8">
              <Button Content="Toggle inspector" Command="{Binding ToggleInspectorCommand}" />
              <controls:PlannerLayersControl Name="PlannerLayers" DataContext="{Binding #PlannerMap.Layers}"/>
            </StackPanel>
            <Border x:Name="PlannerTerrainMinimap" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource SurfaceBorder}"
                    BorderThickness="1" CornerRadius="6" Padding="7" Margin="12"
                    HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
              <controls:TerrainPreviewPanel>
              <StackPanel Spacing="5">
                <TextBlock TextWrapping="Wrap" Text="Terrain" FontSize="{DynamicResource TextSmall}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"/>
                <controls:LocalTerrainMap Width="208" ExternalChrome="True"
                                          MetresPerPixel="{Binding GroundMetresPerPixel, ElementName=PlannerMap}"
                                          MainViewportHeightPixels="{Binding ViewportHeightPixels, ElementName=PlannerMap}"
                                          ContextMultiplier="{Binding SettingsTerrainMinimapContext}"
                                          Map="{Binding TerrainDebugMap}"
                                          Observer="{Binding Observer}"
                                          LoadState="{Binding TerrainDebugMapLoadState}"
                                          CentreBearingDegrees="{Binding TerrainDebugBearing}"
                                          HorizontalFieldOfViewDegrees="{Binding TerrainDebugHorizontalFieldOfView}"/>
              </StackPanel>
              <StackPanel Spacing="5">
                <TextBlock TextWrapping="Wrap" Text="Terrain frame" FontSize="{DynamicResource TextSmall}" FontWeight="SemiBold" Margin="0,5,0,0"/>
                <controls:TerrainFrameView Width="208" Depth="{Binding TerrainFrameDepth}" Threshold="{Binding TerrainFrameThreshold}" Status="{Binding TerrainFrameStatus}" IsHitTestVisible="False"/>
                <TextBlock Text="{Binding TerrainFrameDirection}" MaxWidth="208" TextWrapping="Wrap" FontSize="{DynamicResource TextCaption}" Foreground="{DynamicResource Warning}"/>
                <WrapPanel Orientation="Horizontal">
                  <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,10,4"><TextBlock Text="Near" FontSize="{DynamicResource TextCaption}"/><Border Width="22" Height="10" VerticalAlignment="Center" Background="{x:Static controls:TerrainFrameView.NearBrush}"/></StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,10,4"><TextBlock Text="Far" FontSize="{DynamicResource TextCaption}"/><Border Width="22" Height="10" VerticalAlignment="Center" Background="{x:Static controls:TerrainFrameView.FarBrush}"/></StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,4"><TextBlock Text="Sky" FontSize="{DynamicResource TextCaption}"/><Border Width="22" Height="10" VerticalAlignment="Center" BorderBrush="{DynamicResource StrongBorder}" BorderThickness="1" Background="{x:Static controls:TerrainFrameView.SkyBrush}"/></StackPanel>
                </WrapPanel>
              </StackPanel>
              </controls:TerrainPreviewPanel>
            </Border>
          </Grid>

          <Border Grid.Column="1" MinWidth="360" MaxWidth="460" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1,0,0,0" IsVisible="{Binding IsInspectorOpen}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="14" Spacing="12">
                <Expander Header="Planning location" IsExpanded="False">
                  <StackPanel Spacing="8" Margin="0,10,0,0">
                    <TextBlock TextWrapping="Wrap" Text="Search for a place" Classes="fieldLabel"/>
                    <controls:LocationSearchControl DataContext="{Binding LocationSearch}" ResultSelected="PlannerSearchResultSelected"/>
                    <TextBlock TextWrapping="Wrap" Text="Planning coordinates" Classes="section" Margin="0,5,0,0"/>
                    <TextBlock TextWrapping="Wrap" Text="Location name" Classes="fieldLabel"/><TextBox Text="{Binding LocationName}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                      <StackPanel><TextBlock TextWrapping="Wrap" Text="Latitude" Classes="fieldLabel"/><NumericUpDown Value="{Binding Latitude}" Minimum="-90" Maximum="90" Increment="0.0001" FormatString="0.00000" MinWidth="135"/></StackPanel>
                      <StackPanel Grid.Column="1"><TextBlock TextWrapping="Wrap" Text="Longitude" Classes="fieldLabel"/><NumericUpDown Value="{Binding Longitude}" Minimum="-180" Maximum="180" Increment="0.0001" FormatString="0.00000" MinWidth="135"/></StackPanel>
                    </Grid>
                    <TextBlock TextWrapping="Wrap" Text="Ground elevation above sea level" Classes="fieldLabel"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><NumericUpDown x:Name="PlannerGroundElevation" Value="{Binding ResolvedGroundElevationMetres, Mode=OneWay}" Minimum="-12000" Maximum="9000" Increment="1" FormatString="0.0" MinWidth="150" IsReadOnly="True" ShowButtonSpinner="False" ToolTip.Tip="Resolved physical surface elevation relative to mean sea level"/><TextBlock TextWrapping="Wrap" Grid.Column="1" Text="m ASL" VerticalAlignment="Center"/></Grid>
                    <TextBlock Text="{Binding GroundElevationSourceText}" Foreground="{DynamicResource SecondaryText}" FontSize="{DynamicResource TextSmall}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding EffectiveObserverAltitudeText}" Foreground="{DynamicResource SecondaryText}" FontSize="{DynamicResource TextSmall}" TextWrapping="Wrap"/>
                    <Button Classes="secondaryAction" Content="Reset to terrain elevation" Command="{Binding ResetGroundElevationCommand}" IsVisible="{Binding IsElevationManualOverride}" IsEnabled="{Binding CanResetGroundElevation}" HorizontalAlignment="Left"/>
                    <WrapPanel><Button Content="Open in Maps" Command="{Binding OpenInMapsCommand}" Margin="0,0,6,6"/><Button Content="Save or update location" Command="{Binding SaveLocationCommand}" Margin="0,0,6,6"/><Button Classes="destructive" Content="Delete saved location" Command="{Binding DeleteLocationCommand}" Margin="0,0,6,6"/></WrapPanel>
                  </StackPanel>
                </Expander>

                <Expander Header="Selected targets" IsExpanded="True">
                  <StackPanel Spacing="8" Margin="0,10,0,0">
                    <ItemsControl ItemsSource="{Binding CelestialObjects}">
                      <ItemsControl.ItemTemplate><DataTemplate>
                        <Border BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="0,0,0,1" Padding="0,7">
                          <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="7">
                            <CheckBox IsChecked="{Binding IsVisible}" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Width="7" Height="24" CornerRadius="3" Background="{Binding Colour}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2"><TextBlock TextWrapping="Wrap" Text="{Binding DisplayName}" FontWeight="SemiBold" /><TextBlock TextWrapping="Wrap" Text="{Binding Detail}" Foreground="{DynamicResource SecondaryText}" FontSize="{DynamicResource TextCaption}" /></StackPanel>
                            <Button Grid.Column="3" Classes="secondaryAction" Content="{Binding PrimaryLabel}" Command="{Binding MakePrimaryCommand}" />
                            <Button Grid.Column="4" Classes="compactDelete" Content="×" Command="{Binding RemoveCommand}" IsVisible="{Binding CanRemove}" ToolTip.Tip="Remove object" AutomationProperties.Name="Remove object" />
                          </Grid>
                        </Border>
                      </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock TextWrapping="Wrap" Text="{Binding VisibleCelestialCountText}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CelestialLimitMessage}" Foreground="{DynamicResource Error}" TextWrapping="Wrap" />
                    <TextBlock Text="Solid line: primary target · dashed lines: visible secondary objects" FontSize="{DynamicResource TextCaption}" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" />
                  </StackPanel>
                </Expander>

                <Expander Header="Current target details" IsExpanded="False">
                  <StackPanel Spacing="8" Margin="0,10,0,0">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                      <StackPanel><TextBlock TextWrapping="Wrap" Text="Azimuth" Classes="fieldLabel"/><TextBlock TextWrapping="Wrap" Classes="metric" Text="{Binding AzimuthText}" /></StackPanel>
                      <StackPanel Grid.Column="1"><TextBlock TextWrapping="Wrap" Text="Altitude" Classes="fieldLabel"/><TextBlock TextWrapping="Wrap" Classes="metric" Text="{Binding AltitudeText}" /></StackPanel>
                    </Grid>
                    <StackPanel Spacing="3">
                      <TextBlock TextWrapping="Wrap" Text="Visibility" Classes="fieldLabel"/>
                      <TextBlock Text="{Binding HorizonStatus}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="5" IsVisible="{Binding HasTargetLocalHorizonDetails}">
                      <TextBlock TextWrapping="Wrap" Text="Local horizon"/><TextBlock TextWrapping="Wrap" Grid.Column="1" Text="{Binding TargetLocalHorizonText}"/>
                      <TextBlock TextWrapping="Wrap" Grid.Row="1" Text="{Binding TargetTerrainMarginLabel}"/><TextBlock TextWrapping="Wrap" Grid.Row="1" Grid.Column="1" Text="{Binding TargetTerrainMarginText}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="5">
                      <TextBlock TextWrapping="Wrap" Text="Rise"/><TextBlock TextWrapping="Wrap" Grid.Column="1" Text="{Binding RiseText}"/><TextBlock TextWrapping="Wrap" Grid.Row="1" Text="Transit"/><TextBlock TextWrapping="Wrap" Grid.Row="1" Grid.Column="1" Text="{Binding TransitText}"/><TextBlock TextWrapping="Wrap" Grid.Row="2" Text="Set"/><TextBlock TextWrapping="Wrap" Grid.Row="2" Grid.Column="1" Text="{Binding SetText}"/>
                    </Grid>
                    <TextBlock Text="{Binding MoonDetails}" IsVisible="{Binding HasMoonDetails}" Foreground="{DynamicResource PrimaryText}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SunDetails}" IsVisible="{Binding HasSunDetails}" Foreground="{DynamicResource Error}" TextWrapping="Wrap" />
                  </StackPanel>
                </Expander>

                <Expander Header="Camera and framing" IsExpanded="True">
                  <StackPanel Spacing="8" Margin="0,10,0,0">
                    <TextBlock TextWrapping="Wrap" Text="Camera" Classes="fieldLabel"/>
                    <ComboBox ItemsSource="{Binding Cameras}" SelectedItem="{Binding SelectedCamera}" MinWidth="190"><ComboBox.ItemTemplate><DataTemplate><TextBlock TextWrapping="Wrap" Text="{Binding DisplayName}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                    <TextBlock TextWrapping="Wrap" Text="Lens" Classes="fieldLabel"/>
                    <ComboBox ItemsSource="{Binding Lenses}" SelectedItem="{Binding SelectedLens}" MinWidth="190"><ComboBox.ItemTemplate><DataTemplate><TextBlock TextWrapping="Wrap" Text="{Binding DisplayName}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                    <TextBlock TextWrapping="Wrap" Text="{Binding LensFocalRangeText}" Foreground="{DynamicResource SecondaryText}" FontSize="{DynamicResource TextSmall}"/>
                    <TextBlock TextWrapping="Wrap" Text="Focal length" Classes="fieldLabel"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                      <Slider x:Name="FocalLengthSlider" Value="{Binding FocalLength}" Minimum="{Binding FocalLengthMinimum}" Maximum="{Binding FocalLengthMaximum}" IsEnabled="{Binding IsFocalLengthEditable}" TickFrequency="1" IsSnapToTickEnabled="True" MinWidth="150" AutomationProperties.Name="Focal length"/>
                      <TextBlock TextWrapping="Wrap" Grid.Column="1" Text="{Binding FocalLength, StringFormat='{}{0:0.#} mm'}" VerticalAlignment="Center" MinWidth="52" TextAlignment="Right"/>
                    </Grid>
                    <TextBlock TextWrapping="Wrap" Text="Camera bearing (°)" Classes="fieldLabel"/>
                    <Grid ColumnDefinitions="*,90" ColumnSpacing="8">
                      <Slider x:Name="CameraBearingSlider" Value="{Binding CameraBearingDegrees}" Minimum="0" Maximum="360" TickFrequency="1" IsSnapToTickEnabled="False" AutomationProperties.Name="Camera bearing"/>
                      <NumericUpDown x:Name="CameraBearingInput" Grid.Column="1" Value="{Binding CameraBearingDegrees}" Minimum="0" Maximum="360" Increment="1" FormatString="0.##" ShowButtonSpinner="False" BorderThickness="0" Background="Transparent" Padding="0" VerticalAlignment="Center" AutomationProperties.Name="Camera bearing precise value"/>
                    </Grid>
                    <TextBlock TextWrapping="Wrap" Text="Camera pitch (°)" Classes="fieldLabel"/>
                    <Grid ColumnDefinitions="*,90" ColumnSpacing="8">
                      <Slider x:Name="CameraPitchSlider" Value="{Binding CameraPitchDegrees}" Minimum="-90" Maximum="90" TickFrequency="1" IsSnapToTickEnabled="False" AutomationProperties.Name="Camera pitch"/>
                      <NumericUpDown x:Name="CameraPitchInput" Grid.Column="1" Value="{Binding CameraPitchDegrees}" Minimum="-90" Maximum="90" Increment="1" FormatString="0.##" ShowButtonSpinner="False" BorderThickness="0" Background="Transparent" Padding="0" VerticalAlignment="Center" AutomationProperties.Name="Camera pitch precise value"/>
                    </Grid>
                    <TextBlock TextWrapping="Wrap" Text="0° horizontal · positive looks upward" FontSize="{DynamicResource TextSmall}" Foreground="{DynamicResource SecondaryText}"/>
                    <TextBlock TextWrapping="Wrap" Text="Orientation" Classes="fieldLabel"/>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                      <RadioButton x:Name="LandscapeOrientationRadioButton" Content="Landscape" GroupName="CameraOrientation" IsChecked="{Binding IsLandscapeOrientation}"/>
                      <RadioButton x:Name="PortraitOrientationRadioButton" Content="Portrait" GroupName="CameraOrientation" IsChecked="{Binding IsPortraitOrientation}"/>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Text="Field of view" Classes="fieldLabel"/><TextBlock TextWrapping="Wrap" Text="{Binding FieldOfViewText}" FontSize="{DynamicResource TextHeading}" FontWeight="SemiBold" />
                    <TextBlock Text="Angular composition guide; not a simulation of terrain perspective." Foreground="{DynamicResource MutedText}" FontSize="{DynamicResource TextSmall}" TextWrapping="Wrap" />
                  </StackPanel>
                </Expander>

                <Expander Header="Weather conditions" IsExpanded="False">
                  <StackPanel Spacing="8" Margin="0,10,0,0">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBlock TextWrapping="Wrap" Text="Weather" Classes="section" VerticalAlignment="Center"/><Button Grid.Column="1" Classes="secondaryAction" Content="Refresh" Command="{Binding RefreshWeatherCommand}"/></Grid>
                    <TextBlock Text="{Binding WeatherSummary}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ConfiguredWeatherDetails}" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap"/>
                  </StackPanel>
                </Expander>

                <Expander Header="Terrain horizon" IsExpanded="False">
                  <StackPanel Spacing="8" Margin="0,10,0,0">
                    <TextBlock Text="{Binding TerrainStatus}" Foreground="{DynamicResource SecondaryText}" FontSize="{DynamicResource TextSmall}" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="5">
                      <TextBlock TextWrapping="Wrap" Text="Current location"/><TextBlock TextWrapping="Wrap" Grid.Column="1" Text="{Binding TerrainCurrentLocationText}"/>
                      <TextBlock TextWrapping="Wrap" Grid.Row="1" Text="Terrain data"/><TextBlock TextWrapping="Wrap" Grid.Row="1" Grid.Column="1" Text="{Binding GroundHorizonState}"/>
                      <TextBlock TextWrapping="Wrap" Grid.Row="2" Text="Terrain horizon"/><TextBlock TextWrapping="Wrap" Grid.Row="2" Grid.Column="1" Text="{Binding GroundHorizonAngleText}"/>
                    </Grid>
                    <TextBlock Text="{Binding TerrainDatumText}" Foreground="{DynamicResource SecondaryText}" FontSize="{DynamicResource TextSmall}" TextWrapping="Wrap"/>
                    <Border Height="1" Background="{DynamicResource ButtonBackground}" Margin="0,2"/>
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto" RowSpacing="5">
                      <TextBlock TextWrapping="Wrap" Text="Terrain obstruction" FontWeight="SemiBold"/><TextBlock TextWrapping="Wrap" Grid.Column="1" Text="{Binding GroundObstructionText}" FontWeight="SemiBold"/>
                    </Grid>
                  </StackPanel>
                </Expander>

              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>

        <Border x:Name="PlannerTimeline" Grid.Row="2" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="0,1,0,0" Padding="14,10">
          <Grid RowDefinitions="Auto,Auto,150" RowSpacing="8">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
              <TextBlock TextWrapping="Wrap" Text="Nearby date" VerticalAlignment="Center"/><Slider Grid.Column="1" Minimum="-45" Maximum="45" TickFrequency="1" Value="{Binding PreviewDateOffsetDays}"/><TextBlock TextWrapping="Wrap" Grid.Column="2" Text="{Binding LocalDate, StringFormat='{}{0:dd MMM yyyy}'}" VerticalAlignment="Center" MinWidth="110"/>
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
              <TextBlock TextWrapping="Wrap" Text="00:00" VerticalAlignment="Center"/><Slider Grid.Column="1" Minimum="0" Maximum="1439" TickFrequency="5" Value="{Binding PreviewMinutesOfDay}" PointerReleased="TimeSliderReleased"/><TextBlock TextWrapping="Wrap" Grid.Column="2" Text="{Binding TimeText}" FontSize="{DynamicResource TextBodyStrong}" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="55"/>
            </Grid>
            <controls:HorizonGraph Grid.Row="2" Snapshot="{Binding Snapshot}" />
          </Grid>
        </Border>
      </Grid>
    </TabItem>

    <TabItem Header="Settings">
      <Grid RowDefinitions="*,Auto">
        <TabControl Margin="24">
          <TabControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></TabControl.ItemsPanel>
          <TabItem Header="General">
            <ScrollViewer><StackPanel Margin="16" Spacing="12" MaxWidth="760">
              <TextBlock TextWrapping="Wrap" Text="General settings" FontSize="{DynamicResource TextTitle}" FontWeight="SemiBold"/>
              <TextBlock Text="External map provider" Classes="fieldLabel"/>
              <ComboBox ItemsSource="{Binding ExternalMapProviders}" SelectedItem="{Binding SettingsExternalMapProvider, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="External map provider">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="Appearance / Accessibility" Classes="section" Margin="0,12,0,0"/>
              <TextBlock Text="Theme" Classes="fieldLabel"/>
              <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}" HorizontalAlignment="Stretch" AutomationProperties.Name="Theme">
                <ComboBox.ItemContainerTheme>
                  <ControlTheme TargetType="ComboBoxItem">
                    <Setter Property="IsEnabled" Value="{Binding IsAvailable}"/>
                    <Setter Property="ToolTip.Tip" Value="{Binding AvailabilityLabel}"/>
                  </ControlTheme>
                </ComboBox.ItemContainerTheme>
                <ComboBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><TextBlock Text="{Binding Label}" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{Binding AvailabilityLabel}" Foreground="{DynamicResource DisabledText}" FontSize="{DynamicResource TextSmall}"/></Grid></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="Mode" FontSize="{DynamicResource TextLabel}" Foreground="{DynamicResource SecondaryText}"/>
              <WrapPanel Name="AppearanceModeChoices">
                <RadioButton Classes="settingsChoice" GroupName="AppearanceModeChoices" Content="System" AutomationProperties.Name="System" IsChecked="{Binding SelectedAppearanceMode, Mode=TwoWay, Converter={StaticResource RadioChoice}, ConverterParameter=System}"/>
                <RadioButton Classes="settingsChoice" GroupName="AppearanceModeChoices" Content="Dark" AutomationProperties.Name="Dark" IsChecked="{Binding SelectedAppearanceMode, Mode=TwoWay, Converter={StaticResource RadioChoice}, ConverterParameter=Dark}"/>
                <RadioButton Classes="settingsChoice" GroupName="AppearanceModeChoices" Content="Light" AutomationProperties.Name="Light" IsChecked="{Binding SelectedAppearanceMode, Mode=TwoWay, Converter={StaticResource RadioChoice}, ConverterParameter=Light}"/>
              </WrapPanel>
              <TextBlock Text="Colour vision mode" Classes="fieldLabel"/>
              <WrapPanel Name="ColourVisionChoices">
                <RadioButton Classes="settingsChoice" GroupName="ColourVisionChoices" Content="None" AutomationProperties.Name="None" IsChecked="{Binding SelectedColourVisionValue, Mode=TwoWay, Converter={StaticResource RadioChoice}, ConverterParameter=None}"/>
                <RadioButton Classes="settingsChoice" GroupName="ColourVisionChoices" Content="Protanopia" AutomationProperties.Name="Protanopia" IsChecked="{Binding SelectedColourVisionValue, Mode=TwoWay, Converter={StaticResource RadioChoice}, ConverterParameter=Protanopia}"/>
                <RadioButton Classes="settingsChoice" GroupName="ColourVisionChoices" Content="Deuteranopia" AutomationProperties.Name="Deuteranopia" IsChecked="{Binding SelectedColourVisionValue, Mode=TwoWay, Converter={StaticResource RadioChoice}, ConverterParameter=Deuteranopia}"/>
                <RadioButton Classes="settingsChoice" GroupName="ColourVisionChoices" Content="Tritanopia" AutomationProperties.Name="Tritanopia" IsChecked="{Binding SelectedColourVisionValue, Mode=TwoWay, Converter={StaticResource RadioChoice}, ConverterParameter=Tritanopia}"/>
              </WrapPanel>
              <TextBlock Text="Text size (100 to 200%)" Classes="fieldLabel"/>
              <StackPanel Spacing="4">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                  <TextBlock Text="100%" VerticalAlignment="Center"/>
                  <Slider Name="AppearanceTextSize" Grid.Column="1" Value="{Binding TextSizePercent, Mode=TwoWay}" Minimum="100" Maximum="200" TickFrequency="10" SmallChange="10" LargeChange="10" IsSnapToTickEnabled="True" AutomationProperties.Name="Text size percent"/>
                  <TextBlock Grid.Column="2" Text="200%" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Name="AppearanceTextSizeValue" Text="{Binding TextSizePercent, StringFormat={}{0:0}%}" HorizontalAlignment="Center"/>
              </StackPanel>
              <TextBlock Text="Appearance changes apply and save immediately. Text size is independent of system display scaling." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" FontSize="{DynamicResource TextSmall}"/>
              <TextBlock TextWrapping="Wrap" Text="Units" Classes="section"/>
              <TextBlock TextWrapping="Wrap" Text="Measurement system" Classes="fieldLabel"/><WrapPanel Name="MeasurementChoices">
                <RadioButton Classes="settingsChoice" GroupName="MeasurementChoices" Content="Metric" AutomationProperties.Name="Metric" IsChecked="{Binding SettingsUnits, Mode=TwoWay, Converter={StaticResource RadioChoice}, ConverterParameter=Metric}"/>
                <RadioButton Classes="settingsChoice" GroupName="MeasurementChoices" Content="Imperial" AutomationProperties.Name="Imperial" IsChecked="{Binding SettingsUnits, Mode=TwoWay, Converter={StaticResource RadioChoice}, ConverterParameter=Imperial}"/>
                <RadioButton Classes="settingsChoice" GroupName="MeasurementChoices" Content="UK" AutomationProperties.Name="UK" IsChecked="{Binding SettingsUnits, Mode=TwoWay, Converter={StaticResource RadioChoice}, ConverterParameter=UK}"/>
              </WrapPanel>
              <TextBlock Text="Metric uses °C, m/s, kilometres and millimetres. Imperial uses °F, mph, miles and inches. UK uses °C, mph, miles and millimetres." Foreground="{DynamicResource SecondaryText}" FontSize="{DynamicResource TextSmall}" TextWrapping="Wrap"/>
              <TextBlock TextWrapping="Wrap" Text="Support" FontSize="{DynamicResource TextTitle}" FontWeight="SemiBold" Margin="0,24,0,0"/>
              <StackPanel Spacing="10" MaxWidth="620" HorizontalAlignment="Left">
                <TextBlock Text="Supporter licence" FontSize="{DynamicResource TextSubheading}" FontWeight="SemiBold"/>
                <TextBlock TextWrapping="Wrap" Text="Unlock supporter cosmetic themes with an Awoo supporter licence." Foreground="{DynamicResource SecondaryText}" FontSize="{DynamicResource TextSmall}"/>
                <StackPanel IsVisible="{Binding IsSupporterLicenceEditorVisible}" Spacing="6">
                  <TextBlock Text="Licence key" Classes="fieldLabel"/>
                  <TextBox Text="{Binding SupporterLicenceInput, Mode=TwoWay}" AutomationProperties.Name="Licence key"/>
                  <Button Content="Activate" Command="{Binding ActivateSupporterLicenceCommand}" HorizontalAlignment="Left"/>
                </StackPanel>
                <StackPanel IsVisible="{Binding HasAwooSupporterEntitlement}" Orientation="Horizontal" Spacing="8">
                  <Button Content="Replace licence" Command="{Binding ReplaceSupporterLicenceCommand}"/>
                  <Button Content="Remove licence" Command="{Binding RemoveSupporterLicenceCommand}"/>
                </StackPanel>
                <TextBlock TextWrapping="Wrap" Text="Status:" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SupporterLicenceStatus}" TextWrapping="Wrap" AutomationProperties.Name="Supporter licence status"/>
                <Button Content="Support on Ko-fi" Command="{Binding OpenKoFiCommand}" HorizontalAlignment="Left" AutomationProperties.Name="Support on Ko-fi"/>
              </StackPanel>
            </StackPanel></ScrollViewer>
          </TabItem>
          <TabItem Header="Equipment">
            <ScrollViewer><StackPanel Margin="16" Spacing="12" MaxWidth="900">
              <TextBlock TextWrapping="Wrap" Text="Equipment" FontSize="{DynamicResource TextTitle}" FontWeight="SemiBold"/>
              <TextBlock TextWrapping="Wrap" Text="Observer" Classes="section"/>
              <TextBlock TextWrapping="Wrap" Text="Camera height above ground" Classes="fieldLabel"/>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><NumericUpDown Value="{Binding SettingsCameraHeightAboveGroundMetres}" Minimum="0" Maximum="100" Increment="0.1" FormatString="0.0"/><TextBlock TextWrapping="Wrap" Grid.Column="1" Text="m AGL" VerticalAlignment="Center"/></Grid>
              <TextBlock Text="This is the physical camera height above local ground. Noctaxis adds it once to the resolved ground elevation for terrain and horizon calculations." Foreground="{DynamicResource SecondaryText}" FontSize="{DynamicResource TextSmall}" TextWrapping="Wrap"/>

              <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0"><TextBlock TextWrapping="Wrap" Text="Cameras" Classes="section"/><Button Grid.Column="1" Content="Add camera" Command="{Binding AddCameraProfileCommand}"/></Grid>
              <TextBlock Text="Enter sensor dimensions in millimetres to calculate the field of view." Foreground="{DynamicResource SecondaryText}" FontSize="{DynamicResource TextSmall}" TextWrapping="Wrap"/>
              <ItemsControl ItemsSource="{Binding EquipmentCameraEditors}"><ItemsControl.ItemTemplate><DataTemplate>
                <Border BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                  <Grid ColumnDefinitions="*,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="7">
                    <StackPanel><TextBlock TextWrapping="Wrap" Text="Name" Classes="fieldLabel"/><TextBox Text="{Binding DisplayName}"/></StackPanel>
                    <Button Grid.Column="2" Classes="compactDelete" Content="×" Command="{Binding RemoveCommand}" AutomationProperties.Name="Remove camera" ToolTip.Tip="Remove camera"/>
                    <StackPanel Grid.Row="1"><TextBlock TextWrapping="Wrap" Text="Sensor width (mm)" Classes="fieldLabel"/><NumericUpDown Value="{Binding SensorWidthMillimetres}" Minimum="0.1" Maximum="100" Increment="0.1" FormatString="0.0"/></StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock TextWrapping="Wrap" Text="Sensor height (mm)" Classes="fieldLabel"/><NumericUpDown Value="{Binding SensorHeightMillimetres}" Minimum="0.1" Maximum="100" Increment="0.1" FormatString="0.0"/></StackPanel>
                    <StackPanel Grid.Row="2"><TextBlock TextWrapping="Wrap" Text="Manufacturer (optional)" Classes="fieldLabel"/><TextBox Text="{Binding Manufacturer}"/></StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1"><TextBlock TextWrapping="Wrap" Text="Model (optional)" Classes="fieldLabel"/><TextBox Text="{Binding Model}"/></StackPanel>
                    <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding ValidationMessage}" Foreground="{DynamicResource Error}" TextWrapping="Wrap"/>
                  </Grid>
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>

              <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0"><TextBlock TextWrapping="Wrap" Text="Lenses" Classes="section"/><Button Grid.Column="1" Content="Add lens" Command="{Binding AddLensProfileCommand}"/></Grid>
              <TextBlock Text="A prime uses the same minimum and maximum focal length. A zoom exposes the configured range in Planner." Foreground="{DynamicResource SecondaryText}" FontSize="{DynamicResource TextSmall}" TextWrapping="Wrap"/>
              <ItemsControl ItemsSource="{Binding EquipmentLensEditors}"><ItemsControl.ItemTemplate><DataTemplate>
                <Border BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                  <Grid ColumnDefinitions="*,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="7">
                    <StackPanel><TextBlock TextWrapping="Wrap" Text="Name" Classes="fieldLabel"/><TextBox Text="{Binding DisplayName}"/></StackPanel>
                    <TextBlock TextWrapping="Wrap" Grid.Column="1" Text="{Binding TypeText}" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Classes="compactDelete" Content="×" Command="{Binding RemoveCommand}" AutomationProperties.Name="Remove lens" ToolTip.Tip="Remove lens"/>
                    <StackPanel Grid.Row="1"><TextBlock TextWrapping="Wrap" Text="Minimum focal length (mm)" Classes="fieldLabel"/><NumericUpDown Value="{Binding MinimumFocalLengthMillimetres}" Minimum="0.1" Maximum="2000" Increment="1" FormatString="0.0"/></StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock TextWrapping="Wrap" Text="Maximum focal length (mm)" Classes="fieldLabel"/><NumericUpDown Value="{Binding MaximumFocalLengthMillimetres}" Minimum="0.1" Maximum="2000" Increment="1" FormatString="0.0"/></StackPanel>
                    <StackPanel Grid.Row="2"><TextBlock TextWrapping="Wrap" Text="Manufacturer (optional)" Classes="fieldLabel"/><TextBox Text="{Binding Manufacturer}"/></StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1"><TextBlock TextWrapping="Wrap" Text="Model (optional)" Classes="fieldLabel"/><TextBox Text="{Binding Model}"/></StackPanel>
                    <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding ValidationMessage}" Foreground="{DynamicResource Error}" TextWrapping="Wrap"/>
                  </Grid>
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel></ScrollViewer>
          </TabItem>
          <TabItem Header="Time">
            <ScrollViewer><StackPanel Margin="16" Spacing="12" MaxWidth="760">
              <TextBlock TextWrapping="Wrap" Text="Time and timezone" FontSize="{DynamicResource TextTitle}" FontWeight="SemiBold"/>
              <TextBlock TextWrapping="Wrap" Text="Planning timezone" Classes="section"/>
              <TextBlock TextWrapping="Wrap" Text="Time zone" Classes="fieldLabel"/><ComboBox ItemsSource="{Binding SettingsTimeZoneOptions}" SelectedItem="{Binding SettingsTimeZoneId}"/>
              <TextBlock Text="Use system time zone follows the operating-system setting. Invalid saved identifiers fall back safely." Foreground="{DynamicResource SecondaryText}" FontSize="{DynamicResource TextSmall}" TextWrapping="Wrap"/>
              <TextBlock Text="Each launch starts at the current time, rounded to the nearest hour. Your equipment, locations and preferences are retained." Foreground="{DynamicResource SecondaryText}" FontSize="{DynamicResource TextSmall}" TextWrapping="Wrap"/>
              <TextBlock TextWrapping="Wrap" Text="Timeline interaction" Classes="section" Margin="0,12,0,0"/>
              <TextBlock TextWrapping="Wrap" Text="Time slider snap interval" Classes="fieldLabel"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><NumericUpDown Value="{Binding SettingsTimeSnapMinutes}" Minimum="1" Maximum="30" Increment="1"/><TextBlock TextWrapping="Wrap" Grid.Column="1" Text="minutes" VerticalAlignment="Center"/></Grid>
              <TextBlock Text="Values from 1 to 30 minutes control only interactive time scrubbing; exact time entry remains available." Foreground="{DynamicResource SecondaryText}" FontSize="{DynamicResource TextSmall}" TextWrapping="Wrap"/>
            </StackPanel></ScrollViewer>
          </TabItem>
          <TabItem Header="Data">
            <!-- Terrain cache uses the same persisted Settings save/reset flow as the other fields. -->
            <ScrollViewer><StackPanel Margin="16" Spacing="12" MaxWidth="760">
              <TextBlock TextWrapping="Wrap" Text="Cache and local data" FontSize="{DynamicResource TextTitle}" FontWeight="SemiBold"/>
              <TextBlock TextWrapping="Wrap" Text="Terrain cache" Classes="section"/>
              <TextBlock TextWrapping="Wrap" Text="{Binding TerrainCacheUsageText}"/>
              <TextBlock TextWrapping="Wrap" Text="Maximum cache size" Classes="fieldLabel"/>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <NumericUpDown Value="{Binding SettingsTerrainCacheLimitGiB}" Minimum="0" Maximum="1024" Increment="0.1" FormatString="0.##"/>
                <TextBlock TextWrapping="Wrap" Grid.Column="1" Text="GiB" VerticalAlignment="Center"/>
              </Grid>
              <TextBlock Text="Save settings to apply. Terrain furthest from saved locations is removed first. Zero disables retention; active downloads may temporarily exceed the limit." Foreground="{DynamicResource SecondaryText}" FontSize="{DynamicResource TextSmall}" TextWrapping="Wrap"/>
              <Button Content="Clear terrain cache" Command="{Binding ClearTerrainCacheCommand}"/>
              <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsClearingTerrainCache}" Height="4"/>
              <TextBlock Text="{Binding TerrainCacheStatus}" FontSize="{DynamicResource TextSmall}" TextWrapping="Wrap"/>
              <TextBlock TextWrapping="Wrap" Text="Environmental source data" Classes="section"/>
              <TextBlock Text="Light Pollution Atlas 2025" Classes="section" Margin="0,12,0,0"/>
              <TextBlock Text="{Binding LightPollutionSourceName}" TextWrapping="Wrap"/>
              <TextBlock Text="Numerical resolution: 1/120° · Coverage: 65°S–75°N. Optional local data; no automatic downloads." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}"/>
              <Button Content="Open source information" Command="{Binding OpenLightPollutionSourceCommand}"/>
              <TextBlock Text="{Binding LightPollutionStatus}" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding LightPollutionProgress}" TextWrapping="Wrap" FontSize="{DynamicResource TextSmall}"/>
              <WrapPanel>
                <Button Content="Install / Repair / Reinstall" Command="{Binding InstallLightPollutionCommand}" IsEnabled="{Binding CanManageLightPollution}"/>
                <Button Content="Cancel" Command="{Binding CancelLightPollutionInstallCommand}" IsVisible="{Binding IsManagingLightPollution}"/>
                <Button Content="Remove" Command="{Binding RemoveLightPollutionCommand}" IsEnabled="{Binding CanManageLightPollution}"/>
              </WrapPanel>
              <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsManagingLightPollution}" Height="4"/>
              <TextBlock Text="Colour map"/>
              <ComboBox ItemsSource="{Binding LightPollutionColorMapOptions}" SelectedItem="{Binding SettingsLightPollutionColorMap}"
                        DisplayMemberBinding="{Binding DisplayName}" AutomationProperties.Name="Light Pollution colour map"/>
              <TextBlock Name="LightPollutionPaletteDescription" Text="{Binding LightPollutionColorMapDescription}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}"/>
              <TextBlock Text="Save settings to apply the colour map. Use Planner → Layers to show the overlay and adjust its opacity." TextWrapping="Wrap" FontSize="{DynamicResource TextSmall}" Foreground="{DynamicResource SecondaryText}"/>
              <TextBlock Text="Mapzen/Tilezen Terrarium terrain, ESA WorldCover and WSF settlement tiles are downloaded on demand and shared between nearby locations. Noctaxis remains usable when a layer is unavailable." Foreground="{DynamicResource SecondaryText}" FontSize="{DynamicResource TextSmall}" TextWrapping="Wrap"/>
              <TextBlock TextWrapping="Wrap" Text="Saved location map images" Classes="section" Margin="0,16,0,0"/>
              <TextBlock Text="Each location keeps a clean source image and processed card artwork with its original map attribution." Foreground="{DynamicResource SecondaryText}" FontSize="{DynamicResource TextSmall}" TextWrapping="Wrap"/>
              <Expander Header="Repair saved map images"><WrapPanel>
                <Button Content="Reapply map image style" Command="{Binding ReapplySavedLocationMapStylesCommand}"/>
                <Button Content="Refresh settlement imagery" Command="{Binding RefreshSavedLocationSettlementCachesCommand}"/>
                <Button Content="Regenerate all map images" Command="{Binding RefreshSavedLocationThumbnailsCommand}"/>
                <ProgressBar Width="90" IsIndeterminate="True" IsVisible="{Binding IsRefreshingLocationThumbnails}" VerticalAlignment="Center"/>
              </WrapPanel></Expander>
              <TextBlock Text="{Binding LocationThumbnailRefreshStatus}" Foreground="{DynamicResource SecondaryText}" FontSize="{DynamicResource TextSmall}" TextWrapping="Wrap"/>
            </StackPanel></ScrollViewer>
          </TabItem>
          <TabItem Header="Appearance">
            <ScrollViewer><StackPanel Margin="16" Spacing="12" MaxWidth="760">
              <TextBlock TextWrapping="Wrap" Text="Map overlay appearance" FontSize="{DynamicResource TextTitle}" FontWeight="SemiBold"/>
              <TextBlock TextWrapping="Wrap" Text="Terrain planning" Classes="section"/>
              <CheckBox Content="Enable terrain calculations" IsChecked="{Binding SettingsEnableTerrainCalculations}"/>
              <TextBlock Text="Uses elevation data for terrain horizons and obstruction. Disable for faster planning without terrain-aware visibility." Foreground="{DynamicResource SecondaryText}" FontSize="{DynamicResource TextSmall}" TextWrapping="Wrap"/>
              <TextBlock TextWrapping="Wrap" Text="Minimum terrain frame coverage" Classes="fieldLabel"/>
              <NumericUpDown Value="{Binding SettingsMinimumTerrainFrameCoveragePercent}" Minimum="0" Maximum="50" Increment="1" FormatString="0\%"/>
              <TextBlock Text="Ignores terrain occupying less than this percentage of the camera frame." FontSize="{DynamicResource TextSmall}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}"/>
              <TextBlock TextWrapping="Wrap" Text="Terrain minimap context" Classes="fieldLabel"/>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Slider Minimum="1" Maximum="2.5" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding SettingsTerrainMinimapContext}"/>
                <TextBlock TextWrapping="Wrap" Grid.Column="1" Text="{Binding SettingsTerrainMinimapContext, StringFormat={}{0:0.00}×}" VerticalAlignment="Center"/>
              </Grid>
              <TextBlock Text="Controls how much surrounding terrain the minimap shows relative to the main map." Foreground="{DynamicResource SecondaryText}" FontSize="{DynamicResource TextSmall}" TextWrapping="Wrap"/>
              <TextBlock TextWrapping="Wrap" Text="Camera framing overlay" Classes="section"/>
              <CheckBox Content="Show camera framing on map" IsChecked="{Binding SettingsCameraFramingOverlayVisible}"/>
              <CheckBox Content="Show weather and terrain visibility limits" IsChecked="{Binding SettingsShowFramingVisibilityLimits}" IsEnabled="{Binding SettingsCameraFramingOverlayVisible}"/>
              <Expander Header="Advanced overlay appearance"><StackPanel Spacing="8" Margin="0,8" IsEnabled="{Binding SettingsCameraFramingOverlayVisible}">
                <TextBlock TextWrapping="Wrap" Text="Camera overlay opacity" Classes="fieldLabel"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><NumericUpDown Value="{Binding SettingsFramingShadingOpacityPercent}" Minimum="0" Maximum="50" Increment="1" FormatString="0"/><TextBlock TextWrapping="Wrap" Grid.Column="1" Text="%" VerticalAlignment="Center"/></Grid>
                <TextBlock Text="Use 0% for transparent boundaries only. Higher values shade the visible camera frame while retaining map detail." Foreground="{DynamicResource SecondaryText}" FontSize="{DynamicResource TextSmall}" TextWrapping="Wrap"/>
                <TextBlock TextWrapping="Wrap" Text="Terrain tint strength" Classes="fieldLabel"/>
<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><Slider x:Name="TerrainTintStrengthSlider" Value="{Binding SettingsTerrainTintStrengthPercent}" Minimum="15" Maximum="55" TickFrequency="1" IsSnapToTickEnabled="True"/><TextBlock TextWrapping="Wrap" Grid.Column="1" Text="{Binding SettingsTerrainTintStrengthPercent, StringFormat={}{0:0}%}" VerticalAlignment="Center"/></Grid>
<TextBlock Text="Maximum terrain tint opacity. Higher values make terrain encroachment more prominent." FontSize="{DynamicResource TextSmall}" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap"/>
<TextBlock TextWrapping="Wrap" Text="Terrain obstruction colour" Classes="fieldLabel"/>
                <ColorPicker x:Name="TerrainObstructionColourPicker" Color="{Binding SettingsTerrainObstructionColour, Mode=TwoWay}" IsAlphaEnabled="False" HorizontalAlignment="Left"/>
                <TextBlock TextWrapping="Wrap" Text="{Binding SettingsTerrainObstructionColourHex}" Foreground="{DynamicResource SecondaryText}"/>
                <TextBlock TextWrapping="Wrap" Text="Boundary line thickness" Classes="fieldLabel"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><NumericUpDown Value="{Binding SettingsFramingLineThickness}" Minimum="0.5" Maximum="5" Increment="0.25" FormatString="0.00"/><TextBlock TextWrapping="Wrap" Grid.Column="1" Text="display units" VerticalAlignment="Center"/></Grid>
              </StackPanel></Expander>
            </StackPanel></ScrollViewer>
          </TabItem>
          <TabItem Header="Weather">
            <ScrollViewer><StackPanel Margin="16" Spacing="12" MaxWidth="900">
              <TextBlock TextWrapping="Wrap" Text="Weather settings" FontSize="{DynamicResource TextTitle}" FontWeight="SemiBold"/>
              <TextBlock Text="Open-Meteo requires no API key. Astronomy values use Noctaxis calculations." Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap"/>
              <TextBlock TextWrapping="Wrap" Text="Cache distance" Classes="fieldLabel"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><NumericUpDown Value="{Binding SettingsWeatherCacheDistance}" Minimum="0" Maximum="100" Increment="0.5"/><TextBlock TextWrapping="Wrap" Grid.Column="1" Text="kilometres" VerticalAlignment="Center"/></Grid>
              <TextBlock Text="Forecasts are reused only within this radius and for less than ten minutes. Manual and export refreshes bypass the cache." Foreground="{DynamicResource SecondaryText}" FontSize="{DynamicResource TextSmall}" TextWrapping="Wrap"/>
              <TextBlock TextWrapping="Wrap" Text="Requested, displayed and exported fields" Classes="section" Margin="0,12,0,0"/>
              <ItemsControl ItemsSource="{Binding WeatherFieldGroups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Spacing="6" Margin="0,0,0,8">
                      <TextBlock TextWrapping="Wrap" Text="{Binding Label}" FontWeight="SemiBold" FontSize="{DynamicResource TextBodyStrong}"/>
                      <ItemsControl ItemsSource="{Binding Fields}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemWidth="260"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsEnabled}" Margin="0,0,8,6"/></DataTemplate></ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel></ScrollViewer>
          </TabItem>
          <TabItem Header="Celestial objects">
            <ScrollViewer><StackPanel Margin="16" Spacing="10" MaxWidth="900">
              <TextBlock TextWrapping="Wrap" Text="Configured celestial objects" FontSize="{DynamicResource TextTitle}" FontWeight="SemiBold"/>
              <TextBlock Text="Search the bundled OpenNGC catalogue, then manage the smaller list available in Planner." Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap"/>
              <TextBox Text="{Binding SettingsCelestialSearch.Query}" PlaceholderText="Search name, alias, M31, NGC 224..."/>
              <Grid ColumnDefinitions="*,*,*,Auto" ColumnSpacing="7">
                <ComboBox ItemsSource="{Binding SettingsCelestialSearch.ObjectTypes}" SelectedItem="{Binding SettingsCelestialSearch.SelectedObjectType}"><ComboBox.ItemTemplate><DataTemplate><TextBlock TextWrapping="Wrap" Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                <ComboBox Grid.Column="1" ItemsSource="{Binding SettingsCelestialSearch.Constellations}" SelectedItem="{Binding SettingsCelestialSearch.SelectedConstellation}"/>
                <ComboBox Grid.Column="2" ItemsSource="{Binding SettingsCelestialSearch.DesignationFamilies}" SelectedItem="{Binding SettingsCelestialSearch.SelectedDesignationFamily}"/>
                <Button Grid.Column="3" Classes="secondaryAction" Content="Reset filters" Command="{Binding SettingsCelestialSearch.ResetFiltersCommand}" IsEnabled="{Binding SettingsCelestialSearch.HasActiveFilters}"/>
              </Grid>
              <ProgressBar IsIndeterminate="True" IsVisible="{Binding SettingsCelestialSearch.IsSearching}"/>
              <TextBlock Text="{Binding SettingsCelestialSearch.EmptyStateMessage}" IsVisible="{Binding SettingsCelestialSearch.ShowEmptyState}" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap"/>
              <ItemsControl ItemsSource="{Binding SettingsCelestialSearch.Results}"><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.AddSettingsCelestialObjectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" Margin="0,0,0,4"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock TextWrapping="Wrap" Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock TextWrapping="Wrap" Text="{Binding PrimaryIdentifier}" Foreground="{DynamicResource SecondaryText}"/></StackPanel><TextBlock TextWrapping="Wrap" Grid.Column="1" Text="Add" VerticalAlignment="Center"/></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <TextBlock TextWrapping="Wrap" Text="{Binding SettingsCelestialSearch.Attribution}" FontSize="{DynamicResource TextCaption}" Foreground="{DynamicResource MutedText}"/>
              <TextBlock TextWrapping="Wrap" Text="{Binding VisibleCelestialCountText}" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding CelestialLimitMessage}" Foreground="{DynamicResource Error}" TextWrapping="Wrap"/>
              <ItemsControl ItemsSource="{Binding CelestialObjects}"><ItemsControl.ItemTemplate><DataTemplate>
                <Border BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="0,0,0,1" Padding="0,8"><Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="7">
                  <CheckBox IsChecked="{Binding IsVisible}" ToolTip.Tip="Show in Planner"/>
                  <StackPanel Grid.Column="1"><TextBlock TextWrapping="Wrap" Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock TextWrapping="Wrap" Text="{Binding Detail}" Foreground="{DynamicResource SecondaryText}" FontSize="{DynamicResource TextCaption}"/></StackPanel>
                  <Button Grid.Column="2" Classes="secondaryAction" Content="Up" Command="{Binding MoveUpCommand}"/><Button Grid.Column="3" Classes="secondaryAction" Content="Down" Command="{Binding MoveDownCommand}"/>
                  <Button Grid.Column="4" Classes="secondaryAction" Content="{Binding PrimaryLabel}" Command="{Binding MakePrimaryCommand}"/>
                  <Button Grid.Column="5" Classes="compactDelete" Content="×" Command="{Binding RemoveCommand}" IsVisible="{Binding CanRemove}" ToolTip.Tip="Remove object" AutomationProperties.Name="Remove object"/>
                </Grid></Border>
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <Button Content="Restore defaults" Command="{Binding RestoreCelestialDefaultsCommand}" HorizontalAlignment="Left"/>
            </StackPanel></ScrollViewer>
          </TabItem>
          <TabItem Header="Debug">
            <ScrollViewer><StackPanel Margin="16" Spacing="12" MaxWidth="760">
              <TextBlock TextWrapping="Wrap" Text="Debug" FontSize="{DynamicResource TextTitle}" FontWeight="SemiBold"/>
              <TextBlock TextWrapping="Wrap" Text="Terrain diagnostics" Classes="section"/>
              <CheckBox Content="Enable terrain diagnostics" IsChecked="{Binding SettingsTerrainDebugOverlay}" IsEnabled="{Binding SettingsEnableTerrainCalculations}"/>
              <TextBlock Text="Inspect the current terrain profile and source data. Save settings to apply. The Planner minimap works independently." Foreground="{DynamicResource SecondaryText}" FontSize="{DynamicResource TextSmall}" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding TerrainDiagnosticsStatus}" TextWrapping="Wrap"/>
              <StackPanel IsVisible="{Binding ShowTerrainDebugOverlay}" Spacing="12">
                <TextBlock TextWrapping="Wrap" Text="Terrain horizon polar view" Classes="section"/>
                <TextBlock Text="Bearing and distance of the sampled horizon, separate from the geographic Planner minimap." Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap"/>
                <diagnostics:TerrainDebugMiniMap Width="236" Height="236" HorizontalAlignment="Left"
                    Profile="{Binding EnabledTerrainDiagnosticsProfile}" Observer="{Binding Observer}"
                    Generation="{Binding TerrainDebugGeneration}" TargetAltitudeDegrees="{Binding TerrainDebugTargetAltitude}"
                    CentreBearingDegrees="{Binding TerrainDebugBearing}" HorizontalFieldOfViewDegrees="{Binding TerrainDebugHorizontalFieldOfView}"
                    WeatherVisibilityDistanceMetres="{Binding CameraFramingVisibility.WeatherVisibilityDistanceMetres}"/>
                <TextBlock TextWrapping="Wrap" Text="Selected bearing" Classes="section"/>
                <TextBlock Text="{Binding CameraFrameDiagnostics}" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding TerrainDiagnosticsBearing}" TextWrapping="Wrap"/>
                <Expander Header="Surface source">
                  <TextBlock Text="{Binding TerrainDiagnosticsSurface}" TextWrapping="Wrap" Margin="0,8"/>
                </Expander>
                <Expander Header="Cache / performance">
                  <StackPanel Spacing="6" Margin="0,8">
                    <TextBlock Text="{Binding TerrainCacheUsageText}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding TerrainDiagnosticsPerformance}" TextWrapping="Wrap"/>
                  </StackPanel>
                </Expander>
                <Expander Header="Advanced source details">
                  <TextBlock Text="{Binding TerrainDiagnosticsAdvanced}" FontFamily="Consolas" FontSize="{DynamicResource TextSmall}" TextWrapping="Wrap" Margin="0,8"/>
                </Expander>
                <Button Content="Copy terrain debug snapshot" Click="CopyTerrainDebugClick" HorizontalAlignment="Left"/>
              </StackPanel>
            </StackPanel></ScrollViewer>
          </TabItem>
        </TabControl>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="24,8,24,18">
          <Button Content="Reset unsaved changes" Command="{Binding ResetSettingsEditorCommand}"/>
          <Button Content="Save settings" Command="{Binding SaveSettingsCommand}"/>
        </StackPanel>
      </Grid>
    </TabItem>
    </TabControl>

    <!-- Declared after the TabControl so existing visual-tree indices are unchanged. -->
    <StackPanel Grid.Row="1">
      <Border x:Name="StartupErrorBanner" IsVisible="{Binding HasStartupError}"
              Background="{DynamicResource ErrorBackground}" BorderBrush="{DynamicResource SurfaceBorder}"
              BorderThickness="0,0,0,1" Padding="14,10">
        <TextBlock Text="{Binding StartupError}" Foreground="{DynamicResource Error}" TextWrapping="Wrap"/>
      </Border>
      <!-- Recoverable, non-fatal problems (e.g. state could not be saved): a dismissible warning. -->
      <Border x:Name="OperationalNoticeBar" IsVisible="{Binding HasOperationalNotice}"
              Background="{DynamicResource WarningBackground}" BorderBrush="{DynamicResource SurfaceBorder}"
              BorderThickness="0,0,0,1" Padding="14,6">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <TextBlock Text="{Binding OperationalNotice}" Foreground="{DynamicResource Warning}"
                     TextWrapping="Wrap" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Classes="secondaryAction" Content="Dismiss"
                  Command="{Binding DismissOperationalNoticeCommand}" VerticalAlignment="Center"/>
        </Grid>
      </Border>
    </StackPanel>
  </Grid>
</Window>
