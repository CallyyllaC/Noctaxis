<views:NoctaxisDialogWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Noctaxis.Desktop.Views"
        x:Class="Noctaxis.Desktop.Views.SavedLocationEditDialog"
        x:CompileBindings="False"
        Title="Edit location" Width="520" Height="390" MinWidth="420" MinHeight="340">
  <Border Classes="noctaxisDialogSurface">
  <Grid RowDefinitions="*,Auto" Margin="22" RowSpacing="16">
    <ScrollViewer><StackPanel Spacing="9">
      <TextBlock TextWrapping="Wrap" Text="Edit location" FontSize="{DynamicResource TextNumeric}" FontWeight="SemiBold"/>
      <TextBlock TextWrapping="Wrap" Text="Location name" Classes="fieldLabel"/>
      <TextBox Text="{Binding Name}"/>
      <TextBlock TextWrapping="Wrap" Text="Description (optional)" Classes="fieldLabel"/>
      <TextBox Text="{Binding Description}" AcceptsReturn="True" MinHeight="80" TextWrapping="Wrap"/>
      <TextBlock TextWrapping="Wrap" Text="Coordinates" Classes="fieldLabel"/>
      <TextBox Text="{Binding Coordinates}" IsReadOnly="True"/>
      <TextBlock TextWrapping="Wrap" Text="{Binding ValidationMessage}" Foreground="{DynamicResource Error}"/>
    </StackPanel></ScrollViewer>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancel" Click="CancelClick" IsCancel="True" MinWidth="90"/>
      <Button x:Name="PrimaryButton" Content="Save changes" Click="SaveClick" IsDefault="True" MinWidth="90"/>
    </StackPanel>
  </Grid>
  </Border>
</views:NoctaxisDialogWindow>
