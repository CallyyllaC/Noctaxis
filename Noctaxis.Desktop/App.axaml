<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="clr-namespace:Noctaxis.Desktop.Themes"
             xmlns:controls="clr-namespace:Noctaxis.Desktop.Controls"
             x:Class="Noctaxis.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    <Style Selector="TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource TextBody}"/>
    </Style>
    <Style Selector="TemplatedControl">
      <Setter Property="FontSize" Value="{DynamicResource TextBody}"/>
    </Style>
    <Style Selector="Button, ToggleButton, ComboBox, NumericUpDown, TextBox">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
    </Style>
    <Style Selector="Button, ToggleButton">
      <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
    </Style>
    <Style Selector="TextBox, NumericUpDown, ComboBox">
      <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBackground}"/>
      <Setter Property="SelectionForegroundBrush" Value="{DynamicResource SelectionForeground}"/>
    </Style>
    <Style Selector="ToolTip">
      <Setter Property="Background" Value="{DynamicResource ElevatedSurface}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource StrongBorder}"/>
    </Style>
    <!-- Interaction states change colour and draw layout-neutral rings (see ThemeService: StateHoverRing and
         friends); they never change BorderThickness, Margin, Padding or size. InteractionGeometryTests. -->
    <Style Selector="Button:focus-visible, ToggleButton:focus-visible, ComboBox:focus-visible, TextBox:focus-within, NumericUpDown:focus-within, Slider:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource FocusBorder}"/>
    </Style>
    <Style Selector="TextBox:focus-within /template/ Border#PART_BorderElement, ComboBox:focus-visible /template/ Border#Background">
      <Setter Property="BoxShadow" Value="{DynamicResource StateFocusRing}"/>
    </Style>
    <!-- Fluent shrinks pressed buttons with a render transform, which also shrinks their hit area: a press
         near the edge could then release outside the button and lose the click. The pressed fill and
         ring already show the press. -->
    <Style Selector="Button:pressed, ToggleButton:pressed, RepeatButton:pressed">
      <Setter Property="RenderTransform" Value="{x:Null}"/>
    </Style>
    <Style Selector="Window">
      <Setter Property="themes:AppearanceLayout.Revision" Value="{DynamicResource AppearanceLayoutRevision}"/>
      <Setter Property="Background" Value="{DynamicResource WindowBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
      <Setter Property="FontFamily" Value="Inter" />
      <Setter Property="FontSize" Value="{DynamicResource TextBody}" />
    </Style>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="12,6" />
    </Style>
    <Style Selector="Button.titleBarButton">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="43" />
      <Setter Property="MinWidth" Value="46" />
      <Setter Property="MinHeight" Value="43" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
      <Setter Property="FontSize" Value="{DynamicResource TextBodyStrong}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.titleBarButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>
    <Style Selector="Button.titleBarButton:pressed">
      <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
    </Style>
    <Style Selector="Button.titleBarClose:pointerover">
      <Setter Property="Background" Value="{DynamicResource ErrorBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource Error}" />
    </Style>
    <Style Selector="Button.titleBarClose:pressed">
      <Setter Property="Background" Value="{DynamicResource ErrorBackground}" />
    </Style>
    <Style Selector="Button.compactDelete">
      <Setter Property="Width" Value="34" />
      <Setter Property="MinWidth" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Error}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Opacity" Value="1" />
      <Setter Property="FontSize" Value="{DynamicResource TextBodyStrong}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.compactDelete:pointerover">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Background" Value="{DynamicResource ErrorBackground}" />
    </Style>
    <Style Selector="Button.compactDelete:focus">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Background" Value="{DynamicResource ErrorBackground}" />
    </Style>
    <Style Selector="Button.secondaryAction">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="9,4" />
      <Setter Property="FontSize" Value="{DynamicResource TextSmall}" />
    </Style>
    <Style Selector="Button.destructive">
      <Setter Property="Foreground" Value="{DynamicResource Error}" />
      <Setter Property="Background" Value="{DynamicResource ErrorBackground}" />
    </Style>
    <Style Selector="Button.destructive:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
      <Setter Property="Background" Value="{DynamicResource ErrorBackground}" />
    </Style>
    <!-- Panels and buttons floating over the Planner map: the theme's translucent map chrome. -->
    <Style Selector="Border.mapChrome">
      <Setter Property="Background" Value="{DynamicResource MapChromeBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MapChromeBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.mapChrome">
      <Setter Property="Background" Value="{DynamicResource MapChromeBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MapChromeBorder}" />
      <Setter Property="Foreground" Value="{DynamicResource MapChromeText}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="MinWidth" Value="110" />
    </Style>
    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
      <Setter Property="FontSize" Value="{DynamicResource TextSmall}" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Settings page structure: category > section > field label > control > description. -->
    <Style Selector="StackPanel.settingsCategory">
      <Setter Property="Margin" Value="16" />
      <Setter Property="Spacing" Value="12" />
      <Setter Property="MaxWidth" Value="860" />
    </Style>
    <Style Selector="TextBlock.settingsTitle">
      <Setter Property="FontSize" Value="{DynamicResource TextTitle}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.settingDescription">
      <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
      <Setter Property="FontSize" Value="{DynamicResource TextSmall}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Application navigation (Locations / Planner / Settings): lightweight text navigation, not a row of
         contained tabs. An inactive page is plain text on the page background; the selected page is named by
         accent colour, weight and the Fluent selection pipe beneath it, so selection never rests on colour
         alone and no item is drawn as a filled, bordered box. The row stays a comfortable touch target: its
         height and padding are hit area, not decoration. -->
    <Style Selector="TabControl.appNavigation">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TabControl.appNavigation > TabItem">
      <Setter Property="FontSize" Value="{DynamicResource TextBody}" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="TabControl.appNavigation > TabItem /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TabControl.appNavigation > TabItem:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource ButtonHover}" />
    </Style>
    <Style Selector="TabControl.appNavigation > TabItem:selected">
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TabControl.appNavigation > TabItem:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TabControl.appNavigation > TabItem:selected:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource ButtonHover}" />
    </Style>
    <!-- Settings category navigation: a vertical rail beside the selected category. The rail scrolls on its
         own, takes at most about a third of the width (names wrap within it rather than squeezing the
         content), and each category's content scrolls independently. -->
    <Style Selector="TabControl.settingsNavigation">
      <Setter Property="TabStripPlacement" Value="Left"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Grid ColumnDefinitions="Auto,*">
            <Border Classes="settingsNavigationRail" MaxWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static controls:FractionConverter.Instance}, ConverterParameter=0.34}">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" Margin="0,0,8,0"/>
              </ScrollViewer>
            </Border>
            <ContentPresenter Name="PART_SelectedContentHost" Grid.Column="1" Margin="{TemplateBinding Padding}"
                              Content="{TemplateBinding SelectedContent}" ContentTemplate="{TemplateBinding SelectedContentTemplate}"/>
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Border.settingsNavigationRail">
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
      <Setter Property="BorderThickness" Value="0,0,1,0"/>
    </Style>
    <Style Selector="TabControl.settingsNavigation > TabItem">
      <Setter Property="FontSize" Value="{DynamicResource TextBody}"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="HeaderTemplate">
        <DataTemplate>
          <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
        </DataTemplate>
      </Setter>
    </Style>
    <!-- Selection is carried by the pipe and the weight as well as the fill, never by colour alone. -->
    <Style Selector="TabControl.settingsNavigation > TabItem:selected">
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.restartAction">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="16,8" />
    </Style>
    <Style Selector="Expander">
      <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
      <Setter Property="Padding" Value="12" />
      <!-- A header may be longer in another language or at a large text size: it wraps, never clips. -->
      <Setter Property="HeaderTemplate">
        <DataTemplate>
          <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
        </DataTemplate>
      </Setter>
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="Border.currentLocationPanel">
      <Setter Property="Background" Value="{DynamicResource LocationCardSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <!-- Room for the slightly larger type inside; the panel keeps its proportions rather than growing. -->
      <Setter Property="Padding" Value="22,19" />
    </Style>
    <Style Selector="Border.emptyLocationPanel">
      <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="Border.noctaxisDialogSurface">
      <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
      <!-- A dialog sits above the page, so its edge is the stronger of the two border roles: enough to read
           as a separate surface without a loud frame. Elevation is left to the window the dialog lives in,
           which is where it is drawn consistently across platforms. -->
      <Setter Property="BorderBrush" Value="{DynamicResource StrongBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <!-- Location cards: calm content-first surfaces from LocationCardTokens. State is shown by border weight
         and by text badges, never by colour alone; decoration never sits behind text. -->
    <Style Selector="Border.editorialLocationCard">
      <Setter Property="Background" Value="{DynamicResource LocationCardSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LocationCardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="BoxShadow" Value="{DynamicResource LocationCardShadow}" />
    </Style>
    <!-- The card keeps a 1px border in every state, so hovering never resizes it (the card grid sizes rows
         from its cards). The heavier state border is the non-hit-testable cardStateRing overlay on top. -->
    <Style Selector="Border.editorialLocationCard:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource StrongBorder}" />
    </Style>
    <Style Selector="Border.editorialLocationCard:pointerover Border.cardStateRing">
      <Setter Property="BorderThickness" Value="{DynamicResource StateHoverInset}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource StrongBorder}" />
    </Style>
    <Style Selector="Border.editorialLocationCard.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Border.editorialLocationCard.selected Border.cardStateRing">
      <Setter Property="BorderThickness" Value="{DynamicResource StateSelectedInset}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Border.editorialLocationCard:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource FocusBorder}" />
    </Style>
    <Style Selector="Border.editorialLocationCard:focus-within Border.cardStateRing">
      <Setter Property="BorderThickness" Value="{DynamicResource StateFocusInset}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource FocusBorder}" />
    </Style>
    <Style Selector="Border.cardStateRing">
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="CornerRadius" Value="11" />
    </Style>
    <Style Selector="Border.lastUsedChip">
      <Setter Property="Background" Value="{DynamicResource LocationCardSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LocationCardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="9,3" />
    </Style>
    <Style Selector="Border.locationBadge">
      <Setter Property="Background" Value="{DynamicResource LocationBadgeBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LocationBadgeBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="7,2,8,2" />
      <Setter Property="Margin" Value="0,0,6,4" />
    </Style>
    <Style Selector="Button.locationCardBody">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.locationCardBody:pointerover">
      <Setter Property="Background" Value="{DynamicResource CardHoverOverlay}" />
    </Style>
    <Style Selector="Button.locationCardBody:focus">
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.cardAction">
      <Setter Property="MinHeight" Value="29" />
      <Setter Property="Padding" Value="9,4" />
      <Setter Property="FontSize" Value="{DynamicResource TextCaption}" />
      <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.cardAction:pointerover">
      <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrongBorder}" />
    </Style>
    <Style Selector="Button.cornerOverflow">
      <Setter Property="Width" Value="44" />
      <Setter Property="MinWidth" Value="44" />
      <Setter Property="Height" Value="42" />
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="12,0,10,0" />
      <Setter Property="Background" Value="{DynamicResource LocationCardSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrongBorder}" />
      <Setter Property="BorderThickness" Value="1,1,0,0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.cornerOverflow:pointerover">
      <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrongBorder}" />
    </Style>
    <Style Selector="Button.favouriteStar">
      <Setter Property="Width" Value="38" />
      <Setter Property="MinWidth" Value="38" />
      <Setter Property="Height" Value="38" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="19" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource LocationCardSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrongBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.favouriteStar:pointerover">
      <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Button.addLocationCard">
      <Setter Property="Padding" Value="18" />
      <Setter Property="Background" Value="{DynamicResource LocationCardSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrongBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Button.addLocationCard:pointerover">
      <Setter Property="Background" Value="{DynamicResource LocationCardSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Border.addLocationGlyph, Border.currentLocationMarker">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Background" Value="{DynamicResource LocationBadgeBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LocationBadgeBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="{DynamicResource TextCaption}" />
      <Setter Property="LetterSpacing" Value="1.4" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="{DynamicResource TextLabel}" />
      <Setter Property="LetterSpacing" Value="1.2" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.metric">
      <Setter Property="FontSize" Value="{DynamicResource TextNumeric}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- Template states must not cover image-backed cards with opaque Fluent fills. -->
    <Style Selector="Button.locationCardBody /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.locationCardBody:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CardHoverOverlay}"/>
    </Style>
    <Style Selector="Button.locationCardBody:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CardPressedOverlay}"/>
    </Style>
    <Style Selector="Button:not(.locationCardBody):pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BoxShadow" Value="{DynamicResource StateHoverRing}"/>
    </Style>
    <Style Selector="Button:not(.locationCardBody):pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BoxShadow" Value="{DynamicResource StatePressedRing}"/>
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BoxShadow" Value="{DynamicResource AccentHoverRing}"/>
    </Style>
    <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BoxShadow" Value="{DynamicResource AccentPressedRing}"/>
    </Style>
    <!-- Map chrome states: the accent marks hover, the pressed accent marks press, over the map. -->
    <Style Selector="Button.mapChrome:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="Foreground" Value="{DynamicResource MapChromeText}"/>
      <Setter Property="BoxShadow" Value="{DynamicResource AccentHoverRing}"/>
    </Style>
    <Style Selector="Button.mapChrome:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentPressed}"/>
      <Setter Property="BoxShadow" Value="{DynamicResource AccentPressedRing}"/>
    </Style>
    <!-- A disabled button hides its border but keeps its width, so enabling it never resizes it. -->
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BoxShadow" Value="none"/>
    </Style>
    <Style Selector="Button:not(.locationCardBody):focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BoxShadow" Value="{DynamicResource StateFocusRing}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource FocusBorder}"/>
    </Style>
    <Style Selector="TabItem:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource FocusBorder}"/>
    </Style>
    <Style Selector="TabItem:focus-visible /template/ Border#PART_LayoutRoot">
      <Setter Property="BoxShadow" Value="{DynamicResource StateFocusOutline}"/>
    </Style>
    <Style Selector="ToggleButton:checked, ListBoxItem:selected, ComboBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource SelectionBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource SelectionForeground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>
    <Style Selector="ToggleButton:checked:not(#ExpanderHeader) /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BoxShadow" Value="{DynamicResource StateSelectedRing}"/>
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BoxShadow" Value="{DynamicResource StateSelectedOutline}"/>
    </Style>
    <Style Selector="ToggleButton:focus-visible, ListBoxItem:focus-visible, ComboBoxItem:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource FocusBorder}"/>
    </Style>
    <Style Selector="ToggleButton:focus-visible:not(#ExpanderHeader) /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BoxShadow" Value="{DynamicResource StateFocusRing}"/>
    </Style>
    <Style Selector="ListBoxItem:focus-visible /template/ ContentPresenter#PART_ContentPresenter, ComboBoxItem:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BoxShadow" Value="{DynamicResource StateFocusOutline}"/>
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter, ComboBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SelectionBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource SelectionForeground}"/>
    </Style>
    <Style Selector="ListBoxItem:not(:selected):pointerover /template/ ContentPresenter, ComboBoxItem:not(:selected):pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ButtonHover}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    </Style>
    <!-- The Fluent progress track reads a fixed platform resource: use the theme role. -->
    <Style Selector="ProgressBar">
      <Setter Property="Background" Value="{DynamicResource SubtleBorder}"/>
    </Style>
    <!-- Shared Fluent Expander header colours; keep its original template and geometry. -->
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
      <Setter Property="Background" Value="{DynamicResource ExpanderHeaderBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ExpanderHeaderBorderBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource ExpanderHeaderForeground}"/>
    </Style>
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:checked:not(:disabled) /template/ Border#ToggleButtonBackground">
      <Setter Property="Background" Value="{DynamicResource ExpanderHeaderExpandedBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ExpanderHeaderBorderBrush}"/>
    </Style>
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:checked:pointerover:not(:disabled) /template/ Border#ToggleButtonBackground">
      <Setter Property="Background" Value="{DynamicResource ExpanderHeaderExpandedBackgroundPointerOver}"/>
    </Style>
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:checked:pressed:not(:disabled) /template/ Border#ToggleButtonBackground">
      <Setter Property="Background" Value="{DynamicResource ExpanderHeaderExpandedBackgroundPressed}"/>
    </Style>
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:checked:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource SelectionForeground}"/>
    </Style>
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:checked:not(:disabled) /template/ Path#ExpandCollapseChevron">
      <Setter Property="Stroke" Value="{DynamicResource SelectionForeground}"/>
    </Style>
  </Application.Styles>
</Application>
