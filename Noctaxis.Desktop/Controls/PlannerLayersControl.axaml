<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Noctaxis.Desktop.ViewModels"
             x:Class="Noctaxis.Desktop.Controls.PlannerLayersControl"
             x:DataType="vm:PlannerLayersViewModel">
  <Button Name="LayersButton" Classes="mapChrome" Content="Layers ▾"
          AutomationProperties.Name="Map layers"
          AutomationProperties.HelpText="Choose the map layers shown in the Planner."
          ToolTip.Tip="Choose the map layers shown in the Planner.">
    <Button.Flyout>
      <Flyout Placement="BottomEdgeAlignedRight" Closed="CommitEdit">
        <Flyout.FlyoutPresenterTheme>
          <ControlTheme TargetType="FlyoutPresenter" BasedOn="{StaticResource {x:Type FlyoutPresenter}}">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
          </ControlTheme>
        </Flyout.FlyoutPresenterTheme>
        <ScrollViewer MaxHeight="420" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Width="280" Spacing="8">
            <TextBlock Text="Map layers" Classes="section"/>
            <TextBlock Text="Overlays" Foreground="{DynamicResource SecondaryText}"/>
            <CheckBox Name="TerrainReliefToggle" Content="Terrain relief"
                      FontSize="{DynamicResource TextBody}" Foreground="{DynamicResource PrimaryText}"
                      AutomationProperties.HelpText="Shade hills and valleys so the shape of the land shows on the map."
                      IsChecked="{Binding ShowTerrainRelief, Mode=TwoWay}"
                      ToolTip.Tip="Shade hills and valleys so the shape of the land shows on the map."/>
            <StackPanel Name="TerrainReliefOpacityControls" IsVisible="{Binding ShowTerrainRelief}" Spacing="4">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Opacity"/>
                <TextBlock Grid.Column="1" Text="{Binding TerrainReliefOpacityPercent, StringFormat='{}{0:F0}%'}"/>
              </Grid>
              <Slider Name="TerrainReliefOpacitySlider" Minimum="0" Maximum="100"
                      Value="{Binding TerrainReliefOpacityPercent, Mode=TwoWay}"
                      AutomationProperties.Name="Terrain relief opacity"
                      AutomationProperties.HelpText="Adjust how strongly hills and valleys are shaded."
                      ToolTip.Tip="Adjust how strongly hills and valleys are shaded."/>
              <TextBlock Text="Not shown over satellite imagery, which already shows the terrain."
                         IsVisible="{Binding IsTerrainReliefOverImagery}" TextWrapping="Wrap"
                         Foreground="{DynamicResource SecondaryText}"/>
            </StackPanel>
            <CheckBox Name="LightPollutionToggle" Content="Light Pollution"
                      FontSize="{DynamicResource TextBody}" Foreground="{DynamicResource PrimaryText}"
                      AutomationProperties.HelpText="Show modelled artificial zenith sky brightness on the map."
                      IsChecked="{Binding ShowLightPollution, Mode=TwoWay}"
                      ToolTip.Tip="Show modelled artificial zenith sky brightness on the map."/>
            <StackPanel Name="OpacityControls" IsVisible="{Binding ShowLightPollution}" Spacing="4">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Opacity"/>
                <TextBlock Grid.Column="1" Text="{Binding LightPollutionOpacityPercent, StringFormat='{}{0:F0}%'}"/>
              </Grid>
              <Slider Name="OpacitySlider" Minimum="0" Maximum="100"
                      Value="{Binding LightPollutionOpacityPercent, Mode=TwoWay}"
                      AutomationProperties.Name="Light Pollution opacity"
                      AutomationProperties.HelpText="Adjust how strongly the Light Pollution overlay covers the base map."
                      ToolTip.Tip="Adjust how strongly the Light Pollution overlay covers the base map."/>
            </StackPanel>
            <TextBlock Text="{Binding PersistenceError}" IsVisible="{Binding HasPersistenceError}"
                       TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}"/>
          </StackPanel>
        </ScrollViewer>
      </Flyout>
    </Button.Flyout>
  </Button>
</UserControl>
