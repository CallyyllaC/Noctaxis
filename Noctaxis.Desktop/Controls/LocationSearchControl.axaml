<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Noctaxis.Desktop.Localisation"
             xmlns:controls="clr-namespace:Noctaxis.Desktop.Controls"
             x:Class="Noctaxis.Desktop.Controls.LocationSearchControl"
             x:CompileBindings="False">
  <StackPanel Spacing="7">
    <!-- Wrapping lets a long placeholder (another language, large text) show in full instead of being cut off. -->
    <TextBox Text="{Binding Query}" TextWrapping="Wrap" PlaceholderText="{loc:Text Locations_Search_PlaceTownCityPostcode_Placeholder}"/>
    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsSearching}"/>
    <controls:StatusText Kind="Error" Text="{Binding ErrorMessage}"/>
    <ItemsControl ItemsSource="{Binding Results}">
      <ItemsControl.ItemTemplate><DataTemplate>
        <Button Click="ResultClick" Tag="{Binding}" HorizontalContentAlignment="Stretch" Margin="0,0,0,4">
          <StackPanel>
            <TextBlock TextWrapping="Wrap" Text="{Binding DisplayName}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding RegionDescription}" Foreground="{DynamicResource SecondaryText}" FontSize="{DynamicResource TextSmall}" TextWrapping="Wrap"/>
            <TextBlock TextWrapping="Wrap" Text="{Binding Country}" Foreground="{DynamicResource MutedText}" FontSize="{DynamicResource TextCaption}"/>
          </StackPanel>
        </Button>
      </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock TextWrapping="Wrap" Text="{Binding Attribution}" FontSize="{DynamicResource TextCaption}" Foreground="{DynamicResource MutedText}"/>
  </StackPanel>
</UserControl>
