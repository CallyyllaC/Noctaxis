<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Noctaxis.Core\Noctaxis.Core.csproj" />
    <!-- A separate process for the single-instance tests; its output is copied beside the tests. -->
    <ProjectReference Include="..\Noctaxis.InstanceProbe\Noctaxis.InstanceProbe.csproj" />
    <!-- SkiaSharp carries its Windows and macOS libraries but not Linux's. The app gets that one through
         Avalonia.Skia; these tests use Skia without Avalonia, so they need it themselves. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Samples\open-meteo-hourly.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Exports as earlier versions wrote them: every supported schema must keep reading these. -->
    <None Include="Samples\Compatibility\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
